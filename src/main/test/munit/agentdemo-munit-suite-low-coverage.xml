<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
        File        : agentdemo-munit-suite-low-coverage.xml
        Purpose     : MUnit test suite for AgentDemo API with LOW code coverage (< 80%).
                      Only covers GET /ping happy path and one GET /objects scenario.
                      POST /objects flow is NOT tested.
                      Error handler branches (400, 404, 405, 406, 415, 500) are NOT tested.
        Coverage    : ~42% — only 2 of 5 flows/branches exercised.
                      Missing: POST /objects flow, all error handler on-error-propagate branches,
                               correlationId fallback, header forwarding, schema validation.
        Author      : AgentDemo QA Team
        Date        : 2026-07-01
        NOTE        : This suite intentionally has incomplete coverage to demonstrate
                      a failing coverage threshold scenario for code review tooling.
    -->

    <munit:config name="agentdemo-munit-suite-low-coverage"
                  doc:name="MUnit Low Coverage Suite"
                  minMuleVersion="4.4.0"/>

    <!-- ================================================================
         SUITE 1 — GET /ping  (Only Happy Path — No Edge Cases)
         ================================================================ -->

    <!--
        Test     : TC-L01 - GET /ping returns status UP
        Flow     : get:\ping:agentdemo-config
        Scenario : Basic happy path — only checks status field
        Coverage : Covers ping flow partially (no timestamp format, no schema check)
        GAP      : Does not validate version, timestamp format, or key presence
    -->
    <munit:test name="TC-L01-get-ping-basic-status-check"
                doc:name="TC-L01: GET /ping - Basic Status Check Only">

        <munit:execution>
            <flow-ref name="get:\ping:agentdemo-config" doc:name="Execute GET /ping"/>
        </munit:execution>

        <munit:validation>
            <!-- Only checking status — missing version and timestamp assertions -->
            <munit-tools:assert-that
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('UP')]"
                doc:name="Assert status is UP"/>
            <!-- MISSING: version assertion -->
            <!-- MISSING: timestamp format assertion -->
            <!-- MISSING: full schema validation -->
        </munit:validation>
    </munit:test>


    <!-- ================================================================
         SUITE 2 — GET /objects  (Only One Shallow Test — No Mocking)
         ================================================================ -->

    <!--
        Test     : TC-L02 - GET /objects basic invocation (no proper mocking)
        Flow     : get:\objects:agentdemo-config
        Scenario : Calls the flow but does NOT mock the downstream HTTP request.
                   This means the test depends on network connectivity to restful-api.dev
                   and will be flaky in CI environments.
        Coverage : Partially covers get-objects flow lines but misses:
                   - Header forwarding assertions
                   - Correlation ID propagation
                   - Empty response edge case
                   - Downstream error handling
        GAP      : No mock — test is environment-dependent and unreliable.
                   No assertions on response structure.
    -->
    <munit:test name="TC-L02-get-objects-no-mock-shallow"
                doc:name="TC-L02: GET /objects - Shallow Test Without Mock (Flaky)"
                ignore="true">
        <!--
            NOTE: Test is marked ignore="true" because it makes a real outbound
            HTTP call to api.restful-api.dev which is not available in offline
            CI environments. This is a code quality issue — tests MUST mock
            external dependencies.
        -->

        <munit:execution>
            <set-variable variableName="correlationId" value="corr-l02" doc:name="Set Correlation ID"/>
            <!-- GAP: No munit-tools:mock-when for http:request component -->
            <flow-ref name="get:\objects:agentdemo-config" doc:name="Execute GET /objects (unmocked)"/>
        </munit:execution>

        <munit:validation>
            <!-- Only checking payload is not null — no structural validation -->
            <munit-tools:assert-that
                expression="#[payload != null]"
                is="#[MunitTools::equalTo(true)]"
                doc:name="Assert payload is not null (weak assertion)"/>
            <!-- MISSING: Array structure validation -->
            <!-- MISSING: Individual field assertions -->
            <!-- MISSING: Correlation ID header forwarding verification -->
        </munit:validation>
    </munit:test>

    <!--
        NOT COVERED — Intentional Gaps for Low Coverage Demo
        ======================================================

        The following flows and branches are NOT tested in this suite,
        resulting in coverage falling below the 80% threshold:

        1. post:\objects:agentdemo-config
           - Happy path (TC-007 in high-coverage suite)
           - Body forwarding verification (TC-008)
           - Minimal payload edge case (TC-009)

        2. global-error-handler — APIKIT:BAD_REQUEST branch
           - Returns { error: "BAD_REQUEST", httpStatus: "400" }

        3. global-error-handler — APIKIT:NOT_FOUND branch
           - Returns { error: "NOT_FOUND", httpStatus: "404" }

        4. global-error-handler — APIKIT:METHOD_NOT_ALLOWED branch
           - Returns { error: "METHOD_NOT_ALLOWED", httpStatus: "405" }

        5. global-error-handler — APIKIT:NOT_ACCEPTABLE branch
           - Returns { error: "NOT_ACCEPTABLE", httpStatus: "406" }

        6. global-error-handler — APIKIT:UNSUPPORTED_MEDIA_TYPE branch
           - Returns { error: "UNSUPPORTED_MEDIA_TYPE", httpStatus: "415" }

        7. global-error-handler — ANY (catch-all 500) branch
           - Returns { error: "INTERNAL_SERVER_ERROR", httpStatus: "500" }

        8. correlationId fallback behavior (when header is missing)

        9. GET /ping — timestamp format validation
           10. GET /ping — response schema / key presence validation

        Total untested processor lines: ~58 of 100 = 58% gap
        Effective coverage: ~42% (below the 80% minimum threshold)
    -->

</mule>
