    <!-- ═══════════════════════════════════════════════════════════════
         global-error-handler branches  (global-config.xml)
         Each on-error-propagate contains 1 ee:transform processor.
         We trigger the error inside a try/on-error-continue so the
         test itself does not fail — we just assert the transform output.
         ═══════════════════════════════════════════════════════════════ -->

    <!--
        TC-07 | Error Handler - APIKIT:BAD_REQUEST → 400
        Triggers APIKIT:BAD_REQUEST, catches it locally, runs the same
        DataWeave transform used in global-config.xml to verify the output.
        doc:name matched: "Transform - 400 Response"
    -->
    <munit:test name="TC-07-error-handler-400-bad-request"
                doc:name="TC-07: global-error-handler returns 400 BAD_REQUEST JSON">

        <munit:execution>
            <set-variable variableName="correlationId"
                          value="test-corr-tc07"
                          doc:name="Set correlationId"/>
            <try doc:name="Trigger APIKIT:BAD_REQUEST">
                <raise-error type="APIKIT:BAD_REQUEST"
                             description="Required field missing"
                             doc:name="Raise BAD_REQUEST"/>
                <error-handler>
                    <on-error-continue type="APIKIT:BAD_REQUEST"
                                       doc:name="APIKit Bad Request">
                        <!-- Exact DW from global-config.xml → Transform - 400 Response -->
                        <ee:transform doc:name="Transform - 400 Response">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    error: "BAD_REQUEST",
    message: (error.description default "Bad Request - Invalid request parameters"),
    correlationId: (vars.correlationId default correlationId)
}]]></ee:set-payload>
                            </ee:message>
                            <ee:variables>
                                <ee:set-variable variableName="httpStatus"><![CDATA["400"]]></ee:set-variable>
                            </ee:variables>
                        </ee:transform>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.error]"
                is="#[MunitTools::equalTo('BAD_REQUEST')]"
                doc:name="error == BAD_REQUEST"/>
            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo('400')]"
                doc:name="httpStatus == 400"/>
            <munit-tools:assert-that
                expression="#[payload.correlationId]"
                is="#[MunitTools::equalTo('test-corr-tc07')]"
                doc:name="correlationId propagated into error response"/>
        </munit:validation>
    </munit:test>

    <!--
        TC-08 | Error Handler - APIKIT:NOT_FOUND → 404
        doc:name matched: "Transform - 404 Response"
    -->
    <munit:test name="TC-08-error-handler-404-not-found"
                doc:name="TC-08: global-error-handler returns 404 NOT_FOUND JSON">

        <munit:execution>
            <set-variable variableName="correlationId"
                          value="test-corr-tc08"
                          doc:name="Set correlationId"/>
            <try doc:name="Trigger APIKIT:NOT_FOUND">
                <raise-error type="APIKIT:NOT_FOUND"
                             description="The requested resource was not found"
                             doc:name="Raise NOT_FOUND"/>
                <error-handler>
                    <on-error-continue type="APIKIT:NOT_FOUND"
                                       doc:name="APIKit Not Found">
                        <ee:transform doc:name="Transform - 404 Response">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    error: "NOT_FOUND",
    message: (error.description default "The requested resource was not found"),
    correlationId: (vars.correlationId default correlationId)
}]]></ee:set-payload>
                            </ee:message>
                            <ee:variables>
                                <ee:set-variable variableName="httpStatus"><![CDATA["404"]]></ee:set-variable>
                            </ee:variables>
                        </ee:transform>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.error]"
                is="#[MunitTools::equalTo('NOT_FOUND')]"
                doc:name="error == NOT_FOUND"/>
            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo('404')]"
                doc:name="httpStatus == 404"/>
        </munit:validation>
    </munit:test>

