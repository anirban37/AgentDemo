    <!-- ================================================================
         SUITE 4 — Error Handler Scenarios
         ================================================================ -->

    <!--
        Test     : TC-010 - 400 Bad Request error handler returns structured JSON
        Flow     : global-error-handler (APIKIT:BAD_REQUEST branch)
        Scenario : Simulate APIKit BAD_REQUEST error and verify JSON error response
        Expects  : error == "BAD_REQUEST", httpStatus == "400", correlationId present
    -->
    <munit:test name="TC-010-error-handler-400-bad-request"
                doc:name="TC-010: Error Handler - 400 Bad Request Response">

        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock Downstream - Trigger 400">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="GET Downstream /objects" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:error typeId="APIKIT:BAD_REQUEST" description="Required field missing"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <set-variable variableName="correlationId" value="corr-tc-010" doc:name="Set Correlation ID"/>
            <try doc:name="Catch Expected Error">
                <flow-ref name="get:\objects:agentdemo-config" doc:name="Execute GET /objects"/>
                <error-handler>
                    <on-error-continue type="APIKIT:BAD_REQUEST" doc:name="Expected 400 Error">
                        <ee:transform doc:name="Build 400 Response">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    error: "BAD_REQUEST",
    message: (error.description default "Bad Request - Invalid request parameters"),
    correlationId: (vars.correlationId default "unknown")
}]]></ee:set-payload>
                            </ee:message>
                            <ee:variables>
                                <ee:set-variable variableName="httpStatus"><![CDATA["400"]]></ee:set-variable>
                            </ee:variables>
                        </ee:transform>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.error]"
                is="#[MunitTools::equalTo('BAD_REQUEST')]"
                doc:name="Assert error type is BAD_REQUEST"/>

            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo('400')]"
                doc:name="Assert HTTP status is 400"/>

            <munit-tools:assert-that
                expression="#[payload.correlationId]"
                is="#[MunitTools::equalTo('corr-tc-010')]"
                doc:name="Assert correlationId in error response"/>
        </munit:validation>
    </munit:test>

    <!--
        Test     : TC-011 - 404 Not Found error handler returns structured JSON
        Flow     : global-error-handler (APIKIT:NOT_FOUND branch)
        Scenario : Simulate APIKIT:NOT_FOUND and verify error response structure
        Expects  : error == "NOT_FOUND", httpStatus == "404"
    -->
    <munit:test name="TC-011-error-handler-404-not-found"
                doc:name="TC-011: Error Handler - 404 Not Found Response">

        <munit:execution>
            <set-variable variableName="correlationId" value="corr-tc-011" doc:name="Set Correlation ID"/>
            <try doc:name="Simulate 404 Error">
                <raise-error type="APIKIT:NOT_FOUND" description="Resource not found" doc:name="Raise 404"/>
                <error-handler>
                    <on-error-continue type="APIKIT:NOT_FOUND" doc:name="Handle 404">
                        <ee:transform doc:name="Build 404 Response">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    error: "NOT_FOUND",
    message: (error.description default "The requested resource was not found"),
    correlationId: (vars.correlationId default "unknown")
}]]></ee:set-payload>
                            </ee:message>
                            <ee:variables>
                                <ee:set-variable variableName="httpStatus"><![CDATA["404"]]></ee:set-variable>
                            </ee:variables>
                        </ee:transform>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.error]"
                is="#[MunitTools::equalTo('NOT_FOUND')]"
                doc:name="Assert error is NOT_FOUND"/>

            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo('404')]"
                doc:name="Assert status 404"/>
        </munit:validation>
    </munit:test>

    <!--
        Test     : TC-012 - 405 Method Not Allowed error handler
        Flow     : global-error-handler (APIKIT:METHOD_NOT_ALLOWED branch)
        Scenario : Raise METHOD_NOT_ALLOWED, verify error response
        Expects  : error == "METHOD_NOT_ALLOWED", httpStatus == "405"
    -->
    <munit:test name="TC-012-error-handler-405-method-not-allowed"
                doc:name="TC-012: Error Handler - 405 Method Not Allowed">

        <munit:execution>
            <set-variable variableName="correlationId" value="corr-tc-012" doc:name="Set Correlation ID"/>
            <try doc:name="Simulate 405 Error">
                <raise-error type="APIKIT:METHOD_NOT_ALLOWED" description="DELETE is not allowed" doc:name="Raise 405"/>
                <error-handler>
                    <on-error-continue type="APIKIT:METHOD_NOT_ALLOWED" doc:name="Handle 405">
                        <ee:transform doc:name="Build 405 Response">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    error: "METHOD_NOT_ALLOWED",
    message: (error.description default "HTTP method not allowed for this resource"),
    correlationId: (vars.correlationId default "unknown")
}]]></ee:set-payload>
                            </ee:message>
                            <ee:variables>
                                <ee:set-variable variableName="httpStatus"><![CDATA["405"]]></ee:set-variable>
                            </ee:variables>
                        </ee:transform>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.error]"
                is="#[MunitTools::equalTo('METHOD_NOT_ALLOWED')]"
                doc:name="Assert error is METHOD_NOT_ALLOWED"/>

            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo('405')]"
                doc:name="Assert status 405"/>
        </munit:validation>
    </munit:test>

    <!--
        Test     : TC-013 - 500 Internal Server Error catch-all handler
        Flow     : global-error-handler (ANY branch)
        Scenario : Simulate unexpected error, verify generic 500 response
        Expects  : error == "INTERNAL_SERVER_ERROR", httpStatus == "500", no stack trace exposed
    -->
    <munit:test name="TC-013-error-handler-500-internal-server-error"
                doc:name="TC-013: Error Handler - 500 Internal Server Error Catch-All">

        <munit:execution>
            <set-variable variableName="correlationId" value="corr-tc-013" doc:name="Set Correlation ID"/>
            <try doc:name="Simulate Unexpected Error">
                <raise-error type="MULE:UNKNOWN" description="Unexpected system failure" doc:name="Raise Generic Error"/>
                <error-handler>
                    <on-error-continue type="ANY" doc:name="Handle ANY Error - 500">
                        <ee:transform doc:name="Build 500 Response">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    error: "INTERNAL_SERVER_ERROR",
    message: "An unexpected error occurred. Please contact support",
    correlationId: (vars.correlationId default "unknown")
}]]></ee:set-payload>
                            </ee:message>
                            <ee:variables>
                                <ee:set-variable variableName="httpStatus"><![CDATA["500"]]></ee:set-variable>
                            </ee:variables>
                        </ee:transform>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.error]"
                is="#[MunitTools::equalTo('INTERNAL_SERVER_ERROR')]"
                doc:name="Assert error is INTERNAL_SERVER_ERROR"/>

            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo('500')]"
                doc:name="Assert status 500"/>

            <munit-tools:assert-that
                expression="#[payload.message]"
                is="#[MunitTools::equalTo('An unexpected error occurred. Please contact support')]"
                doc:name="Assert generic error message (no stack trace)"/>
        </munit:validation>
    </munit:test>

    <!--
        Test     : TC-014 - correlationId defaults to Mule correlationId when header absent
        Flow     : get:\ping:agentdemo-config  (indirectly tests correlationId fallback)
        Scenario : No x-correlation-id header set; vars.correlationId should fallback
        Expects  : Flow completes, status is UP
    -->
    <munit:test name="TC-014-ping-no-correlation-header-fallback"
                doc:name="TC-014: GET /ping - Missing Correlation Header Uses Default">

        <munit:execution>
            <!-- Deliberately do NOT set correlationId variable -->
