 <flow name="read-rules-flow">
      <http:listener config-ref="Listener-config" path="/getrules" doc:name="Get Rules HTTP Endpoint"/>
    
    <logger doc:name="Log HTTP Request" level="INFO" message="HTTP getrules called with query params: #[attributes.queryParams]"/>
    
    <!-- Prepare arguments as Map -->
    <ee:transform doc:name="Prepare MCP Arguments">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    "category": attributes.queryParams.category default attributes.queryParams.category default null
}]]></ee:set-payload>
        </ee:message>
    </ee:transform>
    
    <!-- Call MCP Client Tool -->
    <mcp:call-tool config-ref="MCPClient" toolName="rule-lookup" doc:name="Call MCP Rule Lookup Tool">
        <mcp:arguments>#[payload]</mcp:arguments>
    </mcp:call-tool>
    
    <!-- Parse MCP response and format according to HTTP endpoint requirements -->
    <ee:transform doc:name="Format HTTP Response">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
do {
    var mcpResponse = read(payload.contents[0].text, "application/json")
    ---
    if (mcpResponse.status == "success") {
        "status": "success",
        "processedAt": now(),
        "total rules fetched": sizeOf(mcpResponse.result),
        "result": mcpResponse.result
    } else {
        "status": "error",
        "processedAt": now(),
        "total rules fetched": 0,
        "error": "rule not found via HTTP endpoint",
        "result": []
    }
}]]></ee:set-payload>
        </ee:message>
    </ee:transform>
    
    <logger doc:name="Log HTTP Response" level="INFO" message="HTTP Response returned"/>
</flow>







