        <logger doc:id="3766f176-240a-4804-84e2-84b203146237" doc:name="Log Request" level="INFO" message="Looking up user: #[vars.userName]"></logger>
        <ee:transform doc:name="Prepare MCP Arguments">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "userName": vars.userName
}]]></ee:set-payload>
        </ee:message>
    </ee:transform>
    
