<!-- Main Endpoint: Query with Optional Filters -->
<flow name="get-estimation-standards-flow" doc:id="8a77b711-7b5f-4c3b-a51f-c127f45297af">
    <http:listener config-ref="Listener-config" 
                   path="/estimation-standards" 
                   doc:name="Get Estimation Standards HTTP Endpoint"/>
    
    <logger doc:name="Log HTTP Request" 
            level="INFO" 
            message="HTTP /estimation-standards called with query params: #[attributes.queryParams]"/>
    
    <!-- Prepare arguments as Map for MCP Tool - ALL FILTERS ARE OPTIONAL -->
    <ee:transform doc:name="Prepare MCP Arguments (Optional Filters)">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    // Only include parameters if they are provided in query string
    (complexity: attributes.queryParams.complexity) if (attributes.queryParams.complexity != null and attributes.queryParams.complexity != ""),
    (category: attributes.queryParams.category) if (attributes.queryParams.category != null and attributes.queryParams.category != ""),
    (minEffortDays: attributes.queryParams.minEffortDays as Number) if (attributes.queryParams.minEffortDays != null and attributes.queryParams.minEffortDays != ""),
    (maxEffortDays: attributes.queryParams.maxEffortDays as Number) if (attributes.queryParams.maxEffortDays != null and attributes.queryParams.maxEffortDays != "")
}]]></ee:set-payload>
        </ee:message>
    </ee:transform>
    
    <logger doc:name="Log MCP Arguments" 
            level="INFO" 
            message="Calling MCP tool with filters: #[payload]"/>
    
    <!-- Call MCP Client Tool -->
    <mcp:call-tool config-ref="MCPClient" 
                   toolName="estimation-standards-lookup" 
                   doc:name="Call MCP Estimation Standards Lookup Tool">
        <mcp:arguments>#[payload]</mcp:arguments>
    </mcp:call-tool>
    
    <!-- Parse MCP response and format according to HTTP endpoint requirements -->
    <ee:transform doc:name="Format HTTP Response">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
do {
    var mcpResponse = read(payload.contents[0].text, "application/json")
    ---
    if (mcpResponse.status == "success") {
        status: "success",
        processedAt: now(),
        source: "MCP Tool via estimation-standards-lookup",
        totalStandards: mcpResponse.totalStandards,
        appliedFilters: mcpResponse.filters,
        standards: mcpResponse.standards
    } else if (mcpResponse.status == "no_results") {
        status: "no_results",
        processedAt: now(),
        source: "MCP Tool via estimation-standards-lookup",
        totalStandards: 0,
        appliedFilters: mcpResponse.filters,
        message: "No estimation standards found matching the provided filters",
        standards: []
    } else {
        status: "error",
        processedAt: now(),
        source: "MCP Tool via estimation-standards-lookup",
        totalStandards: 0,
        error: "Estimation standards not found via HTTP endpoint",
        standards: []
    }
}]]></ee:set-payload>
        </ee:message>
    </ee:transform>
    
    <logger doc:name="Log HTTP Response" 
            level="INFO" 
            message="HTTP Response returned: #[payload.totalStandards] standards with filters: #[payload.appliedFilters]"/>
</flow>


<!-- Alternative Endpoint: Simple GET by Complexity (URI Parameter) -->
<flow name="get-estimation-by-complexity-flow" doc:id="e98f170d-dcc0-4364-b76c-b2e45333f4dc">
    <http:listener config-ref="Listener-config" 
                   path="/estimation-standards/{complexity}" 
                   doc:name="Get Standards by Complexity Endpoint"/>
    
    <logger doc:name="Log Request" 
            level="INFO" 
            message="Fetching estimation standards for complexity: #[attributes.uriParams.complexity]"/>
    
    <!-- Prepare MCP arguments with URI parameter -->
    <ee:transform doc:name="Prepare MCP Arguments">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    complexity: attributes.uriParams.complexity
}]]></ee:set-payload>
        </ee:message>
    </ee:transform>
    
    <!-- Call MCP Tool -->
    <mcp:call-tool config-ref="MCPClient" 
                   toolName="estimation-standards-lookup" 
                   doc:name="Call MCP Tool">
        <mcp:arguments>#[payload]</mcp:arguments>
    </mcp:call-tool>
    
    <!-- Format response -->
    <ee:transform doc:name="Format Response">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
read(payload.contents[0].text, "application/json")]]></ee:set-payload>
        </ee:message>
    </ee:transform>
    
    <logger doc:name="Log Response" 
            level="INFO" 
            message="Response: #[payload.totalStandards] standards returned"/>
</flow>





<flow name="get-doc-rules-flow">
    <http:listener config-ref="Listener-config" path="/getdocrules" doc:name="Get Doc Rules HTTP Endpoint"/>

    <logger doc:name="Log HTTP Request" level="INFO" message="HTTP /getdocrules called with query params: #[attributes.queryParams]"/>

    <ee:transform doc:name="Prepare MCP Arguments">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
    (category: attributes.queryParams.category) if (attributes.queryParams.category != null and attributes.queryParams.category != ""),
    (type: attributes.queryParams.type)         if (attributes.queryParams.type != null and attributes.queryParams.type != "")
}]]></ee:set-payload>
        </ee:message>
    </ee:transform>

    <mcp:call-tool config-ref="MCPClient" toolName="doc-rule-lookup" doc:name="Call MCP Doc Rule Lookup Tool">
        <mcp:arguments>#[payload]</mcp:arguments>
    </mcp:call-tool>

    <ee:transform doc:name="Format HTTP Response">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
do {
    var mcpResponse = read(payload.contents[0].text, "application/json")
    ---
    if (mcpResponse.status == "success") {
        "status":             "success",
        "processedAt":        now(),
        "totalRulesFetched":  sizeOf(mcpResponse.result),
        "result":             mcpResponse.result
    } else {
        "status":             "error",
        "processedAt":        now(),
        "totalRulesFetched":  0,
        "error":              "No document rules found via HTTP endpoint",
        "result":             []
    }
}]]></ee:set-payload>
        </ee:message>
    </ee:transform>

    <logger doc:name="Log HTTP Response" level="INFO" message="Doc Rules HTTP Response returned"/>
</flow>

